# RetailGuard Backend — LOCAL DEVELOPMENT DEFAULTS ONLY
# Copy this file to backend/.env and adjust for your machine.
# These values match docker-compose.yml (local Postgres/Redis) and the offline sync + auth
# configuration documented in docs/architecture/. They are NOT safe for production —
# set strong random secrets and real connection strings before any production deploy.

# Application
NODE_ENV=development
PORT=3100
API_PREFIX=api/v1

# Database (matches docker-compose.yml postgres service)
DATABASE_URL="postgresql://retailguard:retailguard_secret_2024@localhost:5432/retailguard"

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=retailguard:

# JWT tokens
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=retailguard-api
JWT_AUDIENCE=retailguard-pos

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Rate limiting
LOGIN_RATE_LIMIT_TTL=60000
LOGIN_RATE_LIMIT_MAX=5
GLOBAL_RATE_LIMIT_TTL=60000
GLOBAL_RATE_LIMIT_MAX=100

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=debug