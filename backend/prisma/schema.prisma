// ─── Warehouse Transfers ─────────────────────────────────────────────

model WarehouseTransfer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  referenceNumber   String    @map("reference_number") @db.VarChar(100)
  fromLocationType  String    @map("from_location_type") @db.VarChar(20)
  fromLocationId    String    @map("from_location_id") @db.Uuid
  toLocationType    String    @map("to_location_type") @db.VarChar(20)
  toLocationId      String    @map("to_location_id") @db.Uuid
  status            String    @default("draft") @db.VarChar(50)
  requestedBy       String    @map("requested_by") @db.Uuid
  approvedBy        String?   @map("approved_by") @db.Uuid
  receivedBy        String?   @map("received_by") @db.Uuid
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz
  inTransitAt       DateTime? @map("in_transit_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  notes             String?   @db.Text
  syncStatus        String    @default("synced") @map("sync_status") @db.VarChar(20)
  serverVersion     Int       @default(1) @map("server_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUser User @relation("TransferRequestedBy", fields: [requestedBy], references: [id])
  approvedByUser User? @relation("TransferApprovedBy", fields: [approvedBy], references: [id])
  receivedByUser User? @relation("TransferReceivedBy", fields: [receivedBy], references: [id])
  transferItems TransferItem[]

  @@map("warehouse_transfers")
  @@index([tenantId])
  @@index([fromLocationType, fromLocationId])
  @@index([toLocationType, toLocationId])
  @@index([status])
  @@index([syncStatus])
}

model TransferItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId        String   @map("transfer_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  quantity          Decimal  @db.Decimal(15, 3)
  unit              String   @db.VarChar(50)
  receivedQuantity  Decimal? @map("received_quantity") @db.Decimal(15, 3)
  status            String   @default("pending") @db.VarChar(50)
  syncStatus        String   @default("synced") @map("sync_status") @db.VarChar(20)
  serverVersion     Int      @default(1) @map("server_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  transfer WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])

  @@map("transfer_items")
  @@index([transferId, tenantId])
  @@index([productId, tenantId])
  @@index([syncStatus])
}